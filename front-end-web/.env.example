# Preferred staging layout: leave empty and reverse-proxy /api and /assets to the backend.
# This keeps the refresh cookie first-party and compatible with SameSite=Strict.
# For a separate HTTPS API origin, set the full base including /api and configure
# backend CORS plus REFRESH_COOKIE_SAME_SITE=none (browser third-party cookie rules still apply).
# VITE_API_URL=https://api.example.com/api
VITE_API_URL=
VITE_MATCHING_V2_ENABLED=false

# Set only when uploaded assets are served from another origin.
# VITE_ASSET_URL=https://api.example.com
VITE_ASSET_URL=
