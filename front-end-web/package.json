{
  "name": "front-end-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:e2e:mobile": "playwright test",
    "test:e2e:qa01": "playwright test --config=playwright.qa01.config.js",
    "test:e2e:disposable": "node e2e/disposable-suite-runner.cjs",
    "test:e2e:harness": "node e2e/support/disposable-env.test.mjs && node e2e/disposable-playwright-launcher.test.cjs && node e2e/support/harness-policy.test.cjs && node e2e/support/secure-artifacts.test.cjs && node e2e/support/managed-process.test.cjs",
    "test:e2e:interviews": "playwright test --config=playwright.interviews.config.js",
    "test:e2e:notifications": "playwright test --config=playwright.notifications.config.js",
    "test:e2e:invitations": "playwright test --config=playwright.invitations.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.3.8"
  }
}
