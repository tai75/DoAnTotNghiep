{
  "name": "job-connect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for AI-powered recruitment connection system",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "node prisma/seed.js",
    "db:seed:staging": "node prisma/seed-staging.js",
    "worker:alerts:once": "node scripts/run-alert-worker-once.js",
    "storage:reconcile": "node scripts/storage-maintenance.cjs reconcile",
    "storage:backup": "node scripts/storage-maintenance.cjs backup",
    "storage:verify": "node scripts/storage-maintenance.cjs verify",
    "storage:restore": "node scripts/storage-maintenance.cjs restore",
    "qa01:db:assert": "node scripts/qa01-db.cjs assert",
    "qa01:db:reset-seed": "node scripts/qa01-db.cjs reset-seed",
    "qa01:db:snapshot": "node scripts/qa01-db.cjs snapshot",
    "qa01:storage:reset": "node scripts/qa01-storage.cjs reset",
    "qa01:server": "node scripts/qa01-server.cjs",
    "e2e:db:identity": "node scripts/e2e-db.cjs identity",
    "e2e:db:canonical": "node scripts/e2e-db.cjs canonical",
    "e2e:db:reset-seed": "node scripts/e2e-db.cjs reset-seed",
    "e2e:db:snapshot": "node scripts/e2e-db.cjs snapshot",
    "e2e:process:verify": "node scripts/e2e-process-guard.cjs verify",
    "e2e:process": "node scripts/e2e-process-guard.cjs refresh",
    "e2e:process:recover-marker": "node scripts/e2e-process-guard.cjs recover-marker",
    "e2e:process:upgrade-marker": "node scripts/e2e-process-guard.cjs upgrade-marker",
    "e2e:prisma:check": "node scripts/e2e-prisma-guard.cjs check",
    "e2e:storage:init": "node scripts/e2e-storage.cjs init",
    "e2e:storage:verify": "node scripts/e2e-storage.cjs verify",
    "e2e:storage:cleanup": "node scripts/e2e-storage.cjs cleanup",
    "e2e:migrate": "node scripts/e2e-launcher.cjs migrate",
    "e2e:server": "node scripts/e2e-launcher.cjs server",
    "e2e:test:qa": "node scripts/e2e-qa-runner.cjs",
    "evaluate:matching": "node scripts/evaluate-matching.js",
    "export:matching-labels": "node scripts/export-matching-labeling.js",
    "prepare:matching-benchmark": "node scripts/prepare-matching-benchmark.js",
    "test": "vitest run --configLoader native",
    "test:unit": "vitest run --configLoader native tests/unit tests/matching.service.test.js tests/jobAlert.service.test.js",
    "test:integration": "vitest run --configLoader native tests/integration tests/routes.test.js tests/security.test.js",
    "test:coverage": "vitest run --configLoader native --coverage",
    "test:watch": "vitest --configLoader native"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "5.3.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "1.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "10.4.1",
    "pdf-parse": "^1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.7.0",
    "supertest": "^7.1.4",
    "vitest": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16"
  }
}
