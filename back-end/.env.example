PORT=5000
NODE_ENV=development
DEPLOY_ENV=development
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/job_connect"
# Required: generate a random value of at least 32 characters. Never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=job_connect_refresh
# Use strict when frontend and API are same-site. Use none only for separate HTTPS sites.
REFRESH_COOKIE_SAME_SITE=strict
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# Durable local storage. Required in production and must be an absolute persistent-volume
# path outside the application source tree. All API instances must share the same mount.
STORAGE_ROOT=
# Read-only compatibility paths for files created before STORAGE-01. New files are never
# written here and legacy files are never automatically moved or deleted.
UPLOADS_DIRECTORY=
LOGOS_DIRECTORY=

# Local development seed only. The normal seed refuses NODE_ENV=production.
ADMIN_SEED_PASSWORD=

# Staging demo seed: set only for the one-off `npm run db:seed:staging` command.
ALLOW_STAGING_SEED=false
STAGING_DATABASE_NAME=job_connect_staging
STAGING_DEMO_CANDIDATE_EMAIL=
STAGING_DEMO_CANDIDATE_PASSWORD=
STAGING_DEMO_RECRUITER_EMAIL=
STAGING_DEMO_RECRUITER_PASSWORD=
STAGING_DEMO_ADMIN_EMAIL=
STAGING_DEMO_ADMIN_PASSWORD=

# Optional SMTP. Without these values, email is not sent and no reset token is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Keep disabled until SMTP sandbox and single-worker execution are verified.
ALERT_WORKER_ENABLED=false
ALERT_WORKER_CRON=0 * * * *
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Legacy V2 only. Keep for rollback; text-embedding-004 is no longer supported.
GEMINI_EMBEDDING_MODEL=text-embedding-004
# V3 is implemented for shadow/offline evaluation and is not activated on an API route yet.
GEMINI_EMBEDDING_V3_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_V3_MODEL_VERSION=gemini-embedding-2
GEMINI_EMBEDDING_V3_DIMENSIONS=768
GEMINI_EMBEDDING_TIMEOUT_MS=8000
GEMINI_EMBEDDING_MAX_RETRIES=2
GEMINI_EMBEDDING_RETRY_BASE_MS=250
MATCHING_V2_ENABLED=false
MATCHING_V3_ENABLED=false
LLM_TIMEOUT_MS=8000

# Keep these stable across all API instances. Do not expose JWT_SECRET to clients.
JWT_ISSUER=job-connect-api
JWT_AUDIENCE=job-connect-web

# Enable only when the API is behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=false
