PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:password@localhost:3306/job_connect"
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=job_connect_refresh
CORS_ORIGINS=http://localhost:5173
ADMIN_SEED_PASSWORD=change-this-demo-password
# Optional SMTP. Without these values, reset links are logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_MS=8000
