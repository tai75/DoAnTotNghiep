model EmbeddingCache {
  id          Int      @id @default(autoincrement())
  contentHash String   @unique @map("content_hash") @db.Char(64)
  vector      Json
  model       String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  ownerUserId Int?     @map("owner_user_id")
  dataSubjectUserId Int? @map("data_subject_user_id")
  aiConsentId Int?     @map("ai_consent_id")
  consentScope AiConsentScope? @map("consent_scope")
  owner       User?    @relation("EmbeddingOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  dataSubject User?    @relation("EmbeddingSubject", fields: [dataSubjectUserId], references: [id], onDelete: SetNull)
  aiConsent   AiConsent? @relation(fields: [aiConsentId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([dataSubjectUserId, consentScope])
  @@index([aiConsentId])
  @@map("embedding_cache")
}

model AiConsent {
  id            Int            @id @default(autoincrement())
  userId        Int            @map("user_id")
  scope         AiConsentScope
  policyVersion String         @map("policy_version") @db.VarChar(40)
  grantedAt     DateTime       @default(now()) @map("granted_at")
  withdrawnAt   DateTime?      @map("withdrawn_at")
  withdrawalRequestedAt DateTime? @map("withdrawal_requested_at")
  withdrawalCompletedAt DateTime? @map("withdrawal_completed_at")
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents   AiUsageEvent[]
  embeddings    EmbeddingCache[]
  resumeJobAnalyses ResumeJobAnalysis[]
  permitBindings AiPermitConsent[]

  @@unique([userId, scope, policyVersion])
  @@index([userId, withdrawnAt])
  @@index([userId, withdrawalRequestedAt])
  @@map("ai_consents")
}

model AiTransmissionPermit {
  id                Int            @id @default(autoincrement())
  requestId         String         @unique @map("request_id") @db.Char(36)
  actorUserId       Int?           @map("actor_user_id")
  scope             AiConsentScope
  status            AiPermitStatus @default(PENDING)
  provider          String         @db.VarChar(80)
  model             String         @db.VarChar(100)
  operation         String         @db.VarChar(80)
  inputDigest       String         @map("input_digest") @db.Char(64)
  deadlineAt        DateTime       @map("deadline_at")
  activatedAt       DateTime?      @map("activated_at")
  completedAt       DateTime?      @map("completed_at")
  cancelRequestedAt DateTime?      @map("cancel_requested_at")
  leaseOwner        String?        @map("lease_owner") @db.VarChar(100)
  leaseToken        String?        @map("lease_token") @db.Char(36)
  leaseExpiresAt    DateTime?      @map("lease_expires_at")
  errorCode         String?        @map("error_code") @db.VarChar(80)
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  actor             User?          @relation("AiPermitActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  bindings          AiPermitConsent[]
  usageEvent        AiUsageEvent?

  @@index([status, deadlineAt])
  @@index([actorUserId, createdAt])
  @@map("ai_transmission_permits")
}

model AiPermitConsent {
  id                Int                  @id @default(autoincrement())
  permitId          Int                  @map("permit_id")
  consentId         Int?                 @map("consent_id")
  dataSubjectUserId Int?                 @map("data_subject_user_id")
  scope             AiConsentScope
  policyVersion     String               @map("policy_version") @db.VarChar(40)
  consentVersion    Int                  @map("consent_version")
  createdAt         DateTime             @default(now()) @map("created_at")
  permit            AiTransmissionPermit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  consent           AiConsent?           @relation(fields: [consentId], references: [id], onDelete: SetNull)
  dataSubject       User?                @relation("AiPermitSubject", fields: [dataSubjectUserId], references: [id], onDelete: SetNull)

  @@unique([permitId, dataSubjectUserId, scope], map: "ai_permit_consents_permit_subject_scope_key")
  @@index([consentId])
  @@index([dataSubjectUserId, scope], map: "ai_permit_consents_subject_scope_idx")
  @@map("ai_permit_consents")
}

model AiUsageEvent {
  id                Int            @id @default(autoincrement())
  actorUserId       Int?           @map("actor_user_id")
  dataSubjectUserId Int?           @map("data_subject_user_id")
  consentId         Int?           @map("consent_id")
  permitId          Int?           @unique @map("permit_id")
  scope             AiConsentScope
  policyVersion     String         @map("policy_version") @db.VarChar(40)
  provider          String         @db.VarChar(80)
  model             String         @db.VarChar(100)
  operation         String         @db.VarChar(80)
  outcome           AiUsageOutcome @default(STARTED)
  inputDigest       String         @map("input_digest") @db.Char(64)
  errorCode         String?        @map("error_code") @db.VarChar(80)
  createdAt         DateTime       @default(now()) @map("created_at")
  completedAt       DateTime?      @map("completed_at")
  actor             User?          @relation("AiUsageActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  dataSubject       User?          @relation("AiUsageSubject", fields: [dataSubjectUserId], references: [id], onDelete: SetNull)
  consent           AiConsent?     @relation(fields: [consentId], references: [id], onDelete: SetNull)
  permit            AiTransmissionPermit? @relation(fields: [permitId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([dataSubjectUserId, scope, createdAt])
  @@index([consentId])
  @@map("ai_usage_events")
}

model Recommendation {
  id          Int       @id @default(autoincrement())
  candidateId Int       @map("candidate_id")
  jobId       Int       @map("job_id")
  score       Decimal   @db.Decimal(5, 2)
  reason      String?   @db.Text
  isViewed    Boolean   @default(false) @map("is_viewed")
  createdAt   DateTime  @default(now()) @map("created_at")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId, score])
  @@map("recommendations")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
