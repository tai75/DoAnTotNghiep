generator client {
  provider = "prisma-client-js"
}

model CompanyFollow {
  candidateId Int       @map("candidate_id")
  companyId   Int       @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([candidateId, companyId])
  @@index([companyId])
  @@map("company_follows")
}

enum CompanyReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyReview {
  id             Int                 @id @default(autoincrement())
  companyId      Int                 @map("company_id")
  userId         Int                 @map("user_id")
  rating         Int
  title          String              @db.VarChar(180)
  pros           String              @db.Text
  cons           String              @db.Text
  isAnonymous    Boolean             @default(false) @map("is_anonymous")
  status         CompanyReviewStatus @default(PENDING)
  moderationNote String?             @map("moderation_note") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, status, createdAt])
  @@map("company_reviews")
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum CompanyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum CompanyVerificationSource {
  LEGACY_BACKFILL
  ADMIN_REVIEW
}

enum CompanyVerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTargetType {
  JOB
  COMPANY
}

enum ReportReason {
  SPAM
  MISLEADING
  DISCRIMINATION
  FRAUD
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum JobStatus {
  DRAFT
  PENDING
  PUBLISHED
  CLOSED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEWING
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InterviewMode {
  ONLINE
  ONSITE
}

enum InterviewStatus {
  PENDING_RESPONSE
  CONFIRMED
  RESCHEDULE_REQUESTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum JobAlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum JobAlertEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AlertDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  UNKNOWN
}

enum AiConsentScope {
  RESUME_IMPORT
  RESUME_JOB_ANALYSIS
  MATCHING_EXPLANATION
  SEMANTIC_MATCHING
  AI_CHAT
  JOB_DESCRIPTION
  RECRUITER_AI_DISCOVERY
}

enum AiUsageOutcome {
  STARTED
  SUCCEEDED
  FAILED
}

enum AiPermitStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
  TIMED_OUT_UNCONFIRMED
  ORPHANED_UNCONFIRMED
}

model User {
  id                            Int                          @id @default(autoincrement())
  email                         String                       @unique @db.VarChar(191)
  passwordHash                  String                       @map("password_hash") @db.VarChar(255)
  fullName                      String                       @map("full_name") @db.VarChar(150)
  phone                         String?                      @db.VarChar(30)
  role                          UserRole                     @default(CANDIDATE)
  status                        UserStatus                   @default(ACTIVE)
  tokenVersion                  Int                          @default(0) @map("token_version")
  createdAt                     DateTime                     @default(now()) @map("created_at")
  updatedAt                     DateTime                     @updatedAt @map("updated_at")
  candidate                     Candidate?
  recruiter                     Recruiter?
  auditLogs                     AuditLog[]
  notifications                 Notification[]
  sentMessages                  Message[]
  passwordResetTokens           PasswordResetToken[]
  refreshTokens                 RefreshToken[]
  authSessions                  AuthSession[]
  applicationNotes              ApplicationNote[]
  savedTalentSearches           RecruiterSavedSearch[]       @relation("SavedTalentSearchAuthor")
  talentInvitationsSent         TalentInvitation[]           @relation("TalentInvitationRecruiter")
  companyReviews                CompanyReview[]
  interviewActions              Interview[]                  @relation("InterviewRecruiter")
  reportsSubmitted              Report[]                     @relation("ReportSubmitter")
  reportsResolved               Report[]                     @relation("ReportResolver")
  verificationRequestsSubmitted CompanyVerificationRequest[] @relation("VerificationRequestSubmitter")
  verificationRequestsReviewed  CompanyVerificationRequest[] @relation("VerificationRequestReviewer")
  aiConsents                    AiConsent[]
  aiUsageEvents                 AiUsageEvent[]                 @relation("AiUsageActor")
  aiSubjectUsageEvents          AiUsageEvent[]                 @relation("AiUsageSubject")
  aiTransmissionPermits         AiTransmissionPermit[]         @relation("AiPermitActor")
  aiPermitSubjects              AiPermitConsent[]              @relation("AiPermitSubject")
  ownedEmbeddingArtifacts       EmbeddingCache[]               @relation("EmbeddingOwner")
  subjectEmbeddingArtifacts     EmbeddingCache[]               @relation("EmbeddingSubject")

  @@map("users")
}

model Candidate {
  id                    Int                   @id @default(autoincrement())
  userId                Int                   @unique @map("user_id")
  headline              String?               @db.VarChar(180)
  bio                   String?               @db.Text
  location              String?               @db.VarChar(150)
  yearsExperience       Decimal?              @map("years_experience") @db.Decimal(4, 1)
  education             String?               @db.VarChar(255)
  resumeUrl             String?               @map("resume_url") @db.VarChar(500)
  desiredPosition       String?               @map("desired_position") @db.VarChar(180)
  desiredSalary         Decimal?              @map("desired_salary") @db.Decimal(15, 2)
  desiredLocation       String?               @map("desired_location") @db.VarChar(150)
  desiredEmploymentType EmploymentType?       @map("desired_employment_type")
  isSearchable          Boolean               @default(false) @map("is_searchable")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                CandidateSkill[]
  applications          Application[]
  recommendations       Recommendation[]
  educations            CandidateEducation[]
  experiences           CandidateExperience[]
  projects              CandidateProject[]
  resumes               CandidateResume[]
  savedJobs             SavedJob[]
  matchScores           MatchScore[]
  matchScoreV2          MatchScoreV2[]
  resumeJobAnalyses     ResumeJobAnalysis[]
  jobAlerts             JobAlert[]
  talentInvitations     TalentInvitation[]    @relation("TalentInvitationCandidate")
  companyFollows        CompanyFollow[]

  @@map("candidates")
}

model Company {
  id                   Int                          @id @default(autoincrement())
  name                 String                       @db.VarChar(180)
  description          String?                      @db.Text
  website              String?                      @db.VarChar(255)
  logoUrl              String?                      @map("logo_url") @db.VarChar(500)
  address              String?                      @db.VarChar(255)
  employeeCount        Int?                         @map("employee_count")
  industry             String?                      @db.VarChar(150)
  status               CompanyStatus                @default(ACTIVE)
  statusReason         String?                      @map("status_reason") @db.Text
  statusChangedAt      DateTime?                    @map("status_changed_at")
  verificationStatus   CompanyVerificationStatus    @default(UNVERIFIED) @map("verification_status")
  verifiedAt           DateTime?                    @map("verified_at")
  verificationSource   CompanyVerificationSource?   @map("verification_source")
  verificationVersion  Int                          @default(0) @map("verification_version")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  recruiters           Recruiter[]
  jobs                 Job[]
  followers            CompanyFollow[]
  reviews              CompanyReview[]
  reports              Report[]
  verificationRequests CompanyVerificationRequest[]

  @@index([status, createdAt])
  @@map("companies")
}

model CompanyVerificationRequest {
  id                Int                              @id @default(autoincrement())
  companyId         Int                              @map("company_id")
  submittedByUserId Int                              @map("submitted_by_user_id")
  reviewedByUserId  Int?                             @map("reviewed_by_user_id")
  status            CompanyVerificationRequestStatus @default(PENDING)
  companyName       String                           @map("company_name") @db.VarChar(180)
  website           String?                          @db.VarChar(255)
  address           String?                          @db.VarChar(255)
  industry          String?                          @db.VarChar(150)
  description       String?                          @db.Text
  rejectionReason   String?                          @map("rejection_reason") @db.Text
  reviewNote        String?                          @map("review_note") @db.Text
  requestKey        String                           @unique @map("request_key") @db.VarChar(100)
  companyVersion    Int                              @map("company_version")
  submittedAt       DateTime                         @default(now()) @map("submitted_at")
  reviewedAt        DateTime?                        @map("reviewed_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")
  company           Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy       User                             @relation("VerificationRequestSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?                            @relation("VerificationRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([companyId, status])
  @@map("company_verification_requests")
}

model Recruiter {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique @map("user_id")
  companyId Int     @map("company_id")
  jobTitle  String? @map("job_title") @db.VarChar(120)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("recruiters")
}

model Skill {
  id         Int              @id @default(autoincrement())
  name       String           @unique @db.VarChar(100)
  createdAt  DateTime         @default(now()) @map("created_at")
  candidates CandidateSkill[]
  jobs       JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  candidateId Int       @map("candidate_id")
  skillId     Int       @map("skill_id")
  level       String?   @db.VarChar(50)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  @@map("candidate_skills")
}

model Job {
  id                      Int                    @id @default(autoincrement())
  companyId               Int                    @map("company_id")
  title                   String                 @db.VarChar(180)
  description             String                 @db.Text
  location                String?                @db.VarChar(150)
  employmentType          EmploymentType?        @map("employment_type")
  minSalary               Decimal?               @map("min_salary") @db.Decimal(15, 2)
  maxSalary               Decimal?               @map("max_salary") @db.Decimal(15, 2)
  requiredYearsExperience Decimal?               @map("required_years_experience") @db.Decimal(4, 1)
  status                  JobStatus              @default(DRAFT)
  moderationNote          String?                @map("moderation_note") @db.Text
  deadline                DateTime?
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills                  JobSkill[]
  applications            Application[]
  screeningQuestions      JobScreeningQuestion[]
  savedBy                 SavedJob[]
  matchScores             MatchScore[]
  matchScoreV2            MatchScoreV2[]
  resumeJobAnalyses       ResumeJobAnalysis[]
  recommendations         Recommendation[]
  views                   JobView[]
  talentInvitations       TalentInvitation[]
  alertEventJobs          JobAlertEventJob[]
  reports                 Report[]

  @@index([status])
  @@index([createdAt])
  @@index([location])
  @@index([deadline])
  @@index([employmentType])
  @@map("jobs")
}

model Report {
  id               Int              @id @default(autoincrement())
  reporterUserId   Int              @map("reporter_user_id")
  resolvedByUserId Int?             @map("resolved_by_user_id")
  targetType       ReportTargetType @map("target_type")
  jobId            Int?             @map("job_id")
  companyId        Int?             @map("company_id")
  reason           ReportReason
  description      String?          @db.Text
  status           ReportStatus     @default(PENDING)
  resolutionNote   String?          @map("resolution_note") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  resolvedAt       DateTime?        @map("resolved_at")
  reporter         User             @relation("ReportSubmitter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  resolvedBy       User?            @relation("ReportResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  job              Job?             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, jobId, companyId])
  @@index([reporterUserId, createdAt])
  @@map("reports")
}

model JobSkill {
  jobId      Int     @map("job_id")
  skillId    Int     @map("skill_id")
  isRequired Boolean @default(true) @map("is_required")
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model Application {
  id                 Int                        @id @default(autoincrement())
  candidateId        Int                        @map("candidate_id")
  jobId              Int                        @map("job_id")
  resumeId           Int?                       @map("resume_id")
  resumePathSnapshot String?                    @map("resume_path_snapshot") @db.VarChar(500)
  coverLetter        String?                    @map("cover_letter") @db.Text
  status             ApplicationStatus          @default(APPLIED)
  appliedAt          DateTime                   @default(now()) @map("applied_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  candidate          Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume             CandidateResume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  history            ApplicationStatusHistory[]
  matchScore         MatchScore?
  answers            ApplicationAnswer[]
  notes              ApplicationNote[]
  conversation       Conversation?
  interviews         Interview[]

  @@unique([candidateId, jobId])
  @@index([jobId, status])
  @@map("applications")
}

model Interview {
  id                    Int             @id @default(autoincrement())
  applicationId         Int             @map("application_id")
  recruiterUserId       Int             @map("recruiter_user_id")
  round                 Int
  scheduledStart        DateTime        @map("scheduled_start")
  scheduledEnd          DateTime        @map("scheduled_end")
  timezone              String          @db.VarChar(100)
  mode                  InterviewMode
  location              String?         @db.VarChar(500)
  meetingUrl            String?         @map("meeting_url") @db.VarChar(1000)
  candidateInstructions String?         @map("candidate_instructions") @db.Text
  recruiterNote         String?         @map("recruiter_note") @db.Text
  candidateResponseNote String?         @map("candidate_response_note") @db.Text
  proposedStart         DateTime?       @map("proposed_start")
  proposedEnd           DateTime?       @map("proposed_end")
  status                InterviewStatus @default(PENDING_RESPONSE)
  version               Int             @default(1)
  requestKey            String          @unique @map("request_key") @db.Char(36)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  application           Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter             User            @relation("InterviewRecruiter", fields: [recruiterUserId], references: [id], onDelete: Restrict)

  @@unique([applicationId, round])
  @@index([applicationId, status])
  @@index([recruiterUserId, scheduledStart])
  @@index([status, scheduledStart])
  @@map("interviews")
}

model Conversation {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique @map("application_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderUserId   Int          @map("sender_user_id")
  content        String       @db.Text
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId, readAt])
  @@map("messages")
}

enum ScreeningQuestionType {
  YES_NO
  NUMBER
  TEXT
  SINGLE_CHOICE
}

model JobScreeningQuestion {
  id          Int                   @id @default(autoincrement())
  jobId       Int                   @map("job_id")
  type        ScreeningQuestionType
  question    String                @db.VarChar(500)
  options     Json?
  isRequired  Boolean               @default(false) @map("is_required")
  isKnockout  Boolean               @default(false) @map("is_knockout")
  idealAnswer String?               @map("ideal_answer") @db.Text
  job         Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers     ApplicationAnswer[]

  @@index([jobId])
  @@map("job_screening_questions")
}

model ApplicationAnswer {
  applicationId Int
  questionId    Int
  answer        String               @db.Text
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      JobScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([applicationId, questionId])
  @@index([questionId])
  @@map("application_answers")
}

model CandidateEducation {
  id          Int       @id @default(autoincrement())
  candidateId Int       @map("candidate_id")
  school      String    @db.VarChar(255)
  major       String?   @db.VarChar(180)
  degree      String?   @db.VarChar(120)
  fromDate    DateTime? @map("from_date")
  toDate      DateTime? @map("to_date")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_educations")
}

model CandidateExperience {
  id          Int       @id @default(autoincrement())
  candidateId Int       @map("candidate_id")
  company     String    @db.VarChar(180)
  title       String    @db.VarChar(180)
  description String?   @db.Text
  fromDate    DateTime? @map("from_date")
  toDate      DateTime? @map("to_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_experiences")
}

model CandidateProject {
  id           Int       @id @default(autoincrement())
  candidateId  Int       @map("candidate_id")
  name         String    @db.VarChar(180)
  description  String?   @db.Text
  link         String?   @db.VarChar(500)
  technologies Json?
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_projects")
}

model CandidateResume {
  id           Int                 @id @default(autoincrement())
  candidateId  Int                 @map("candidate_id")
  fileName     String              @map("file_name") @db.VarChar(255)
  path         String              @db.VarChar(500)
  mimeType     String              @map("mime_type") @db.VarChar(100)
  size         Int
  isDefault    Boolean             @default(false) @map("is_default")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  candidate    Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]
  jobAnalyses  ResumeJobAnalysis[]

  @@index([candidateId, isDefault])
  @@map("candidate_resumes")
}

model ResumeJobAnalysis {
  id              Int             @id @default(autoincrement())
  resumeId        Int             @map("resume_id")
  jobId           Int             @map("job_id")
  fitScore        Decimal         @map("fit_score") @db.Decimal(5, 2)
  missingKeywords Json            @map("missing_keywords")
  strengths       Json
  suggestions     Json
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  resume          CandidateResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate       Candidate?      @relation(fields: [candidateId], references: [id])
  candidateId     Int?
  aiConsentId     Int?            @map("ai_consent_id")
  aiConsent       AiConsent?      @relation(fields: [aiConsentId], references: [id], onDelete: SetNull)

  @@unique([resumeId, jobId])
  @@index([jobId])
  @@index([aiConsentId])
  @@map("resume_job_analyses")
}

model SavedJob {
  candidateId Int       @map("candidate_id")
  jobId       Int       @map("job_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([candidateId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

model Notification {
  id            Int            @id @default(autoincrement())
  userId        Int            @map("user_id")
  type          String         @db.VarChar(80)
  title         String         @db.VarChar(180)
  content       String         @db.Text
  link          String?        @db.VarChar(500)
  isRead        Boolean        @default(false) @map("is_read")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAlertEvent JobAlertEvent?

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model JobAlert {
  id             Int                @id @default(autoincrement())
  candidateId    Int                @map("candidate_id")
  name           String             @db.VarChar(150)
  keyword        String?            @db.VarChar(180)
  location       String?            @db.VarChar(150)
  employmentType EmploymentType?    @map("employment_type")
  minSalary      Decimal?           @map("min_salary") @db.Decimal(15, 2)
  skillIds       Json               @map("skill_ids")
  frequency      JobAlertFrequency  @default(DAILY)
  isActive       Boolean            @default(true) @map("is_active")
  lastSentAt     DateTime?          @map("last_sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  events         JobAlertEvent[]
  eventJobs      JobAlertEventJob[]

  @@index([candidateId, isActive])
  @@map("job_alerts")
}

model JobAlertEvent {
  id                Int                 @id @default(autoincrement())
  alertId           Int                 @map("alert_id")
  eventKey          String              @unique @map("event_key") @db.Char(64)
  windowStart       DateTime            @map("window_start")
  windowEnd         DateTime            @map("window_end")
  status            JobAlertEventStatus @default(PENDING)
  leaseOwner        String?             @map("lease_owner") @db.VarChar(100)
  leaseExpiresAt    DateTime?           @map("lease_expires_at")
  retryCount        Int                 @default(0) @map("retry_count")
  nextRetryAt       DateTime?           @map("next_retry_at")
  inAppStatus       AlertDeliveryStatus @default(PENDING) @map("in_app_status")
  emailStatus       AlertDeliveryStatus @default(PENDING) @map("email_status")
  notificationId    Int?                @unique @map("notification_id")
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  providerResponse  Json?               @map("provider_response")
  lastErrorCode     String?             @map("last_error_code") @db.VarChar(100)
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  alert             JobAlert            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  notification      Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  jobs              JobAlertEventJob[]

  @@unique([alertId, windowStart, windowEnd])
  @@index([status, nextRetryAt])
  @@index([emailStatus, nextRetryAt, leaseExpiresAt])
  @@index([leaseExpiresAt])
  @@map("job_alert_events")
}

model JobAlertEventJob {
  eventId Int           @map("event_id")
  alertId Int           @map("alert_id")
  jobId   Int           @map("job_id")
  event   JobAlertEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  alert   JobAlert      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  job     Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([eventId, jobId])
  @@unique([alertId, jobId])
  @@index([jobId])
  @@map("job_alert_event_jobs")
}

model RecruiterSavedSearch {
  id              Int      @id @default(autoincrement())
  recruiterUserId Int      @map("recruiter_user_id")
  name            String   @db.VarChar(150)
