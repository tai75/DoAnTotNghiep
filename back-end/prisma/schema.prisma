generator client {
  provider = "prisma-client-js"
}

model CompanyFollow {
  candidateId Int       @map("candidate_id")
  companyId   Int       @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([candidateId, companyId])
  @@index([companyId])
  @@map("company_follows")
}

enum CompanyReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyReview {
  id             Int                 @id @default(autoincrement())
  companyId      Int                 @map("company_id")
  userId         Int                 @map("user_id")
  rating         Int
  title          String              @db.VarChar(180)
  pros           String              @db.Text
  cons           String              @db.Text
  isAnonymous    Boolean             @default(false) @map("is_anonymous")
  status         CompanyReviewStatus @default(PENDING)
  moderationNote String?             @map("moderation_note") @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, status, createdAt])
  @@map("company_reviews")
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum JobStatus {
  DRAFT
  PENDING
  PUBLISHED
  CLOSED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEWING
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum JobAlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum JobAlertEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AlertDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  UNKNOWN
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique @db.VarChar(191)
  passwordHash          String                 @map("password_hash") @db.VarChar(255)
  fullName              String                 @map("full_name") @db.VarChar(150)
  phone                 String?                @db.VarChar(30)
  role                  UserRole               @default(CANDIDATE)
  status                UserStatus             @default(ACTIVE)
  tokenVersion          Int                    @default(0) @map("token_version")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  candidate             Candidate?
  recruiter             Recruiter?
  auditLogs             AuditLog[]
  notifications         Notification[]
  sentMessages          Message[]
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]
  applicationNotes      ApplicationNote[]
  savedTalentSearches   RecruiterSavedSearch[] @relation("SavedTalentSearchAuthor")
  talentInvitationsSent TalentInvitation[]     @relation("TalentInvitationRecruiter")
  companyReviews        CompanyReview[]

  @@map("users")
}

model Candidate {
  id                    Int                   @id @default(autoincrement())
  userId                Int                   @unique @map("user_id")
  headline              String?               @db.VarChar(180)
  bio                   String?               @db.Text
  location              String?               @db.VarChar(150)
  yearsExperience       Decimal?              @map("years_experience") @db.Decimal(4, 1)
  education             String?               @db.VarChar(255)
  resumeUrl             String?               @map("resume_url") @db.VarChar(500)
  desiredPosition       String?               @map("desired_position") @db.VarChar(180)
  desiredSalary         Decimal?              @map("desired_salary") @db.Decimal(15, 2)
  desiredLocation       String?               @map("desired_location") @db.VarChar(150)
  desiredEmploymentType EmploymentType?       @map("desired_employment_type")
  isSearchable          Boolean               @default(true) @map("is_searchable")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                CandidateSkill[]
  applications          Application[]
  recommendations       Recommendation[]
  educations            CandidateEducation[]
  experiences           CandidateExperience[]
  projects              CandidateProject[]
  resumes               CandidateResume[]
  savedJobs             SavedJob[]
  matchScores           MatchScore[]
  matchScoreV2          MatchScoreV2[]
  resumeJobAnalyses     ResumeJobAnalysis[]
  jobAlerts             JobAlert[]
  talentInvitations     TalentInvitation[]    @relation("TalentInvitationCandidate")
  companyFollows        CompanyFollow[]

  @@map("candidates")
}

model Company {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(180)
  description   String?         @db.Text
  website       String?         @db.VarChar(255)
  logoUrl       String?         @map("logo_url") @db.VarChar(500)
  address       String?         @db.VarChar(255)
  employeeCount Int?            @map("employee_count")
  industry      String?         @db.VarChar(150)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  recruiters    Recruiter[]
  jobs          Job[]
  followers     CompanyFollow[]
  reviews       CompanyReview[]

  @@map("companies")
}

model Recruiter {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique @map("user_id")
  companyId Int     @map("company_id")
  jobTitle  String? @map("job_title") @db.VarChar(120)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("recruiters")
}

model Skill {
  id         Int              @id @default(autoincrement())
  name       String           @unique @db.VarChar(100)
  createdAt  DateTime         @default(now()) @map("created_at")
  candidates CandidateSkill[]
  jobs       JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  candidateId Int       @map("candidate_id")
  skillId     Int       @map("skill_id")
  level       String?   @db.VarChar(50)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  @@map("candidate_skills")
}

model Job {
  id                      Int                    @id @default(autoincrement())
  companyId               Int                    @map("company_id")
  title                   String                 @db.VarChar(180)
  description             String                 @db.Text
  location                String?                @db.VarChar(150)
  employmentType          EmploymentType?        @map("employment_type")
  minSalary               Decimal?               @map("min_salary") @db.Decimal(15, 2)
  maxSalary               Decimal?               @map("max_salary") @db.Decimal(15, 2)
  requiredYearsExperience Decimal?               @map("required_years_experience") @db.Decimal(4, 1)
  status                  JobStatus              @default(DRAFT)
  moderationNote          String?                @map("moderation_note") @db.Text
  deadline                DateTime?
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills                  JobSkill[]
  applications            Application[]
  screeningQuestions      JobScreeningQuestion[]
  savedBy                 SavedJob[]
  matchScores             MatchScore[]
  matchScoreV2            MatchScoreV2[]
  resumeJobAnalyses       ResumeJobAnalysis[]
  recommendations         Recommendation[]
  views                   JobView[]
  talentInvitations       TalentInvitation[]
  alertEventJobs          JobAlertEventJob[]

  @@index([status])
  @@index([createdAt])
  @@index([location])
  @@index([deadline])
  @@index([employmentType])
  @@map("jobs")
}

model JobSkill {
  jobId      Int     @map("job_id")
  skillId    Int     @map("skill_id")
  isRequired Boolean @default(true) @map("is_required")
  job        Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model Application {
  id                 Int                        @id @default(autoincrement())
  candidateId        Int                        @map("candidate_id")
  jobId              Int                        @map("job_id")
  resumeId           Int?                       @map("resume_id")
  resumePathSnapshot String?                    @map("resume_path_snapshot") @db.VarChar(500)
  coverLetter        String?                    @map("cover_letter") @db.Text
  status             ApplicationStatus          @default(APPLIED)
  appliedAt          DateTime                   @default(now()) @map("applied_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  candidate          Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume             CandidateResume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  history            ApplicationStatusHistory[]
  matchScore         MatchScore?
  answers            ApplicationAnswer[]
  notes              ApplicationNote[]
  conversation       Conversation?

  @@unique([candidateId, jobId])
  @@index([jobId, status])
  @@map("applications")
}

model Conversation {
  id            Int         @id @default(autoincrement())
  applicationId Int         @unique @map("application_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@map("conversations")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  senderUserId   Int          @map("sender_user_id")
  content        String       @db.Text
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderUserId, readAt])
  @@map("messages")
}

enum ScreeningQuestionType {
  YES_NO
  NUMBER
  TEXT
  SINGLE_CHOICE
}

model JobScreeningQuestion {
  id          Int                   @id @default(autoincrement())
  jobId       Int                   @map("job_id")
  type        ScreeningQuestionType
  question    String                @db.VarChar(500)
  options     Json?
  isRequired  Boolean               @default(false) @map("is_required")
  isKnockout  Boolean               @default(false) @map("is_knockout")
  idealAnswer String?               @map("ideal_answer") @db.Text
  job         Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers     ApplicationAnswer[]

  @@index([jobId])
  @@map("job_screening_questions")
}

model ApplicationAnswer {
  applicationId Int
  questionId    Int
  answer        String               @db.Text
  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      JobScreeningQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([applicationId, questionId])
  @@index([questionId])
  @@map("application_answers")
}

model CandidateEducation {
  id          Int       @id @default(autoincrement())
  candidateId Int       @map("candidate_id")
  school      String    @db.VarChar(255)
  major       String?   @db.VarChar(180)
  degree      String?   @db.VarChar(120)
  fromDate    DateTime? @map("from_date")
  toDate      DateTime? @map("to_date")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_educations")
}

model CandidateExperience {
  id          Int       @id @default(autoincrement())
  candidateId Int       @map("candidate_id")
  company     String    @db.VarChar(180)
  title       String    @db.VarChar(180)
  description String?   @db.Text
  fromDate    DateTime? @map("from_date")
  toDate      DateTime? @map("to_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_experiences")
}

model CandidateProject {
  id           Int       @id @default(autoincrement())
  candidateId  Int       @map("candidate_id")
  name         String    @db.VarChar(180)
  description  String?   @db.Text
  link         String?   @db.VarChar(500)
  technologies Json?
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_projects")
}

model CandidateResume {
  id           Int                 @id @default(autoincrement())
  candidateId  Int                 @map("candidate_id")
  fileName     String              @map("file_name") @db.VarChar(255)
  path         String              @db.VarChar(500)
  mimeType     String              @map("mime_type") @db.VarChar(100)
  size         Int
  isDefault    Boolean             @default(false) @map("is_default")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  candidate    Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[]
  jobAnalyses  ResumeJobAnalysis[]

  @@index([candidateId, isDefault])
  @@map("candidate_resumes")
}

model ResumeJobAnalysis {
  id              Int             @id @default(autoincrement())
  resumeId        Int             @map("resume_id")
  jobId           Int             @map("job_id")
  fitScore        Decimal         @map("fit_score") @db.Decimal(5, 2)
  missingKeywords Json            @map("missing_keywords")
  strengths       Json
  suggestions     Json
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  resume          CandidateResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate       Candidate?      @relation(fields: [candidateId], references: [id])
  candidateId     Int?

  @@unique([resumeId, jobId])
  @@index([jobId])
  @@map("resume_job_analyses")
}

model SavedJob {
  candidateId Int       @map("candidate_id")
  jobId       Int       @map("job_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([candidateId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

model Notification {
  id            Int            @id @default(autoincrement())
  userId        Int            @map("user_id")
  type          String         @db.VarChar(80)
  title         String         @db.VarChar(180)
  content       String         @db.Text
  link          String?        @db.VarChar(500)
  isRead        Boolean        @default(false) @map("is_read")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAlertEvent JobAlertEvent?

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model JobAlert {
  id             Int                @id @default(autoincrement())
  candidateId    Int                @map("candidate_id")
  name           String             @db.VarChar(150)
  keyword        String?            @db.VarChar(180)
  location       String?            @db.VarChar(150)
  employmentType EmploymentType?    @map("employment_type")
  minSalary      Decimal?           @map("min_salary") @db.Decimal(15, 2)
  skillIds       Json               @map("skill_ids")
  frequency      JobAlertFrequency  @default(DAILY)
  isActive       Boolean            @default(true) @map("is_active")
  lastSentAt     DateTime?          @map("last_sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  events         JobAlertEvent[]
  eventJobs      JobAlertEventJob[]

  @@index([candidateId, isActive])
  @@map("job_alerts")
}

model JobAlertEvent {
  id                Int                 @id @default(autoincrement())
  alertId           Int                 @map("alert_id")
  eventKey          String              @unique @map("event_key") @db.Char(64)
  windowStart       DateTime            @map("window_start")
  windowEnd         DateTime            @map("window_end")
  status            JobAlertEventStatus @default(PENDING)
  leaseOwner        String?             @map("lease_owner") @db.VarChar(100)
  leaseExpiresAt    DateTime?           @map("lease_expires_at")
  retryCount        Int                 @default(0) @map("retry_count")
  nextRetryAt       DateTime?           @map("next_retry_at")
  inAppStatus       AlertDeliveryStatus @default(PENDING) @map("in_app_status")
  emailStatus       AlertDeliveryStatus @default(PENDING) @map("email_status")
  notificationId    Int?                @unique @map("notification_id")
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  providerResponse  Json?               @map("provider_response")
  lastErrorCode     String?             @map("last_error_code") @db.VarChar(100)
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  alert             JobAlert            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  notification      Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  jobs              JobAlertEventJob[]

  @@unique([alertId, windowStart, windowEnd])
  @@index([status, nextRetryAt])
  @@index([emailStatus, nextRetryAt, leaseExpiresAt])
  @@index([leaseExpiresAt])
  @@map("job_alert_events")
}

model JobAlertEventJob {
  eventId Int           @map("event_id")
  alertId Int           @map("alert_id")
  jobId   Int           @map("job_id")
  event   JobAlertEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  alert   JobAlert      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  job     Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([eventId, jobId])
  @@unique([alertId, jobId])
  @@index([jobId])
  @@map("job_alert_event_jobs")
}

model RecruiterSavedSearch {
  id              Int      @id @default(autoincrement())
  recruiterUserId Int      @map("recruiter_user_id")
  name            String   @db.VarChar(150)
  filters         Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  recruiter       User     @relation("SavedTalentSearchAuthor", fields: [recruiterUserId], references: [id], onDelete: Cascade)

  @@index([recruiterUserId, createdAt])
  @@map("recruiter_saved_searches")
}

enum TalentInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model TalentInvitation {
  id              Int                    @id @default(autoincrement())
  candidateId     Int                    @map("candidate_id")
  recruiterUserId Int                    @map("recruiter_user_id")
  jobId           Int                    @map("job_id")
  status          TalentInvitationStatus @default(PENDING)
  message         String?                @db.Text
  createdAt       DateTime               @default(now()) @map("created_at")
  respondedAt     DateTime?              @map("responded_at")
  candidate       Candidate              @relation("TalentInvitationCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter       User                   @relation("TalentInvitationRecruiter", fields: [recruiterUserId], references: [id], onDelete: Cascade)
  job             Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, recruiterUserId, jobId])
  @@index([candidateId, status])
  @@map("talent_invitations")
}

model JobView {
  id        Int      @id @default(autoincrement())
  jobId     Int      @map("job_id")
  viewerKey String   @map("viewer_key") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, viewerKey, createdAt])
  @@index([jobId, createdAt])
  @@map("job_views")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("refresh_tokens")
}

model ApplicationStatusHistory {
  id            Int                @id @default(autoincrement())
  applicationId Int                @map("application_id")
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  note          String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at")
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

model ApplicationNote {
  id            Int         @id @default(autoincrement())
  applicationId Int         @map("application_id")
  authorUserId  Int         @map("author_user_id")
  content       String      @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("application_notes")
}

model MatchScore {
  id               Int          @id @default(autoincrement())
  candidateId      Int          @map("candidate_id")
  jobId            Int          @map("job_id")
  applicationId    Int?         @unique @map("application_id")
  score            Decimal      @db.Decimal(5, 2)
  skillScore       Decimal      @map("skill_score") @db.Decimal(5, 2)
  experienceScore  Decimal      @map("experience_score") @db.Decimal(5, 2)
  positionScore    Decimal      @map("position_score") @db.Decimal(5, 2)
  locationScore    Decimal      @map("location_score") @db.Decimal(5, 2)
  salaryScore      Decimal      @map("salary_score") @db.Decimal(5, 2)
  employmentScore  Decimal      @map("employment_score") @db.Decimal(5, 2)
  matchedSkills    Json?        @map("matched_skills")
  missingSkills    Json?        @map("missing_skills")
  explanation      String?      @db.Text
  computedAt       DateTime     @map("computed_at")
  algorithmVersion String       @map("algorithm_version") @db.VarChar(50)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application      Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([jobId, score])
  @@map("match_scores")
}

model MatchScoreV2 {
  id               Int       @id @default(autoincrement())
  candidateId      Int       @map("candidate_id")
  jobId            Int       @map("job_id")
  score            Decimal   @db.Decimal(5, 2)
  skillScore       Decimal   @map("skill_score") @db.Decimal(5, 2)
  experienceScore  Decimal   @map("experience_score") @db.Decimal(5, 2)
  positionScore    Decimal   @map("position_score") @db.Decimal(5, 2)
  locationScore    Decimal   @map("location_score") @db.Decimal(5, 2)
  salaryScore      Decimal   @map("salary_score") @db.Decimal(5, 2)
  employmentScore  Decimal   @map("employment_score") @db.Decimal(5, 2)
  semanticScore    Decimal   @map("semantic_score") @db.Decimal(5, 2)
  matchedSkills    Json?     @map("matched_skills")
  missingSkills    Json?     @map("missing_skills")
  computedAt       DateTime  @map("computed_at")
  algorithmVersion String    @map("algorithm_version") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([jobId, score])
  @@map("match_scores_v2")
}

model EmbeddingCache {
  id          Int      @id @default(autoincrement())
  contentHash String   @unique @map("content_hash") @db.Char(64)
  vector      Json
  model       String   @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("embedding_cache")
}

model Recommendation {
  id          Int       @id @default(autoincrement())
  candidateId Int       @map("candidate_id")
  jobId       Int       @map("job_id")
  score       Decimal   @db.Decimal(5, 2)
  reason      String?   @db.Text
  isViewed    Boolean   @default(false) @map("is_viewed")
  createdAt   DateTime  @default(now()) @map("created_at")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId, score])
  @@map("recommendations")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
